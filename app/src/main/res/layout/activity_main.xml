<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            style="@style/Hint"
            android:text="@string/app_subtitle" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_shizuku" />

        <TextView
            android:id="@+id/shizuku_status"
            style="@style/Body" />

        <Button
            android:id="@+id/shizuku_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_permission"
            android:visibility="gone" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_joycons" />

        <TextView
            android:id="@+id/left_status"
            style="@style/Body" />

        <TextView
            android:id="@+id/right_status"
            style="@style/Body" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_virtual" />

        <TextView
            android:id="@+id/merge_status"
            style="@style/Body" />

        <Button
            android:id="@+id/merge_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_merging" />

        <TextView
            android:id="@+id/error_text"
            style="@style/Body"
            android:textColor="?android:attr/colorError"
            android:visibility="gone" />

        <Switch
            android:id="@+id/nintendo_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nintendo_layout"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            style="@style/Hint"
            android:text="@string/nintendo_layout_hint" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_test" />

        <TextView
            style="@style/Hint"
            android:text="@string/test_hint" />

        <TextView
            android:id="@+id/input_source"
            style="@style/Body"
            android:text="@string/input_none" />

        <TextView
            android:id="@+id/input_buttons"
            style="@style/Body" />

        <TextView
            android:id="@+id/input_axes"
            style="@style/Body"
            android:fontFamily="monospace" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_devices" />

        <TextView
            android:id="@+id/device_list"
            style="@style/Body" />

        <TextView
            style="@style/Hint"
            android:text="@string/devices_hint" />
    </LinearLayout>
</ScrollView>
