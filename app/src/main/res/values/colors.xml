<resources>
    <color name="ic_launcher_background">#23232A</color>

    <!-- Surfaces and text (light). Dark values in values-night/colors.xml. -->
    <color name="bg">@android:color/system_neutral1_10</color>
    <color name="card">@android:color/system_neutral1_50</color>
    <color name="divider">@android:color/system_neutral2_100</color>
    <color name="text_primary">@android:color/system_neutral1_900</color>
    <color name="text_secondary">@android:color/system_neutral2_700</color>

    <!-- Accent -->
    <color name="primary">@android:color/system_accent1_600</color>
    <color name="on_primary">@android:color/system_accent1_0</color>
    <color name="tonal">@android:color/system_accent2_100</color>
